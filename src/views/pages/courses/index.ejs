<%- include('../../partials/header') %>

<section class="page-hero">
  <div class="container">
    <h1>All courses</h1>
    <p class="lead">Free, project-based courses for every level. Enroll in one click and track your progress.</p>
    <form class="filter-bar" method="get" action="/courses">
      <div class="input-icon">
        <%- icon('search') %>
        <input class="input" type="search" name="q" value="<%= filters.q %>" placeholder="Search courses" aria-label="Search courses">
      </div>
      <select class="input" name="category" aria-label="Category">
        <option value="">All categories</option>
        <% categories.forEach(function (category) { %>
          <option value="<%= category %>" <%= filters.category === category ? 'selected' : '' %>><%= category %></option>
        <% }) %>
      </select>
      <select class="input" name="level" aria-label="Level">
        <option value="">All levels</option>
        <% levels.forEach(function (level) { %>
          <option value="<%= level %>" <%= filters.level === level ? 'selected' : '' %>><%= level %></option>
        <% }) %>
      </select>
      <button class="btn btn-primary" type="submit">Filter</button>
      <% if (filters.q || filters.category || filters.level) { %>
        <a class="btn btn-ghost" href="/courses">Clear</a>
      <% } %>
    </form>
  </div>
</section>

<section class="section section-tight">
  <div class="container">
    <% if (courses.length) { %>
      <p class="muted result-count"><%= pluralize(courses.length, 'course') %></p>
      <div class="card-grid">
        <% courses.forEach(function (course) { %><%- include('../../partials/course-card', { course }) %><% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <%- icon('search', 'icon-xl') %>
        <h3>No courses found</h3>
        <p class="muted">Try a different search or <a href="/courses">browse all courses</a>.</p>
      </div>
    <% } %>
  </div>
</section>

<%- include('../../partials/footer') %>
