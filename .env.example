# Copy this file to .env and adjust as needed. Every value is optional.

# Port the web server listens on
PORT=3000

# Brand name shown in the navbar, page titles and footer
SITE_NAME=CodeNest

# Long random string used to sign session cookies.
# If unset, one is generated on first start and stored in data/.session-secret
# SESSION_SECRET=change-me-to-a-long-random-string

# Where the SQLite database and uploaded files are stored
# DATA_DIR=data
# UPLOAD_DIR=uploads

# Seed demo courses, tutorials and the demo student on first start (true/false)
SEED_DEMO_DATA=true

# Show the demo login credentials on the login page. Turn this off in production!
SHOW_DEMO_CREDENTIALS=true

# Allow anyone to create an account from /signup
ALLOW_SIGNUP=true

# Demo accounts created on first start (only used when the database is empty)
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=Admin@123
DEMO_STUDENT_EMAIL=student@example.com
DEMO_STUDENT_PASSWORD=Student@123

# Largest lesson video an admin can upload, in megabytes
MAX_VIDEO_MB=500

# Login/signup attempts allowed per IP per 15 minutes
AUTH_RATE_LIMIT=20

# Set when running behind a reverse proxy (nginx, Render, Railway, Heroku...) so
# secure cookies and client IPs work. Usually 1.
# TRUST_PROXY=1
